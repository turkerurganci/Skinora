{
  "name": "skinora-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Skinora end-to-end tests (T107, rewritten for P2P in T138). Playwright drives the docker-compose.e2e.yml stack; the two steps the platform is not party to — the buyer's on-chain payment and the seller-to-buyer Steam trade — are simulated on the fake sidecar's control surface.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test happy-path.smoke",
    "test:ui": "playwright test happy-path.ui",
    "test:cancel": "playwright test cancellation",
    "test:timeout": "playwright test timeout",
    "test:payment": "playwright test payment-edge-cases",
    "test:fraud": "playwright test fraud-flags",
    "test:hold": "playwright test emergency-hold",
    "test:admin": "playwright test admin-flows",
    "test:downtime": "playwright test downtime",
    "test:delivery": "playwright test delivery",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
