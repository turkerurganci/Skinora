{
  "permissions": {
    "allow": [
      "Bash(npm init:*)",
      "Bash(npm install:*)",
      "WebFetch(domain:steamcommunity.com)",
      "WebSearch",
      "Edit(.claude/**)",
      "Edit(Docs/**)",
      "Edit(backend/**)",
      "Edit(frontend/**)",
      "Edit(sidecar-steam/**)",
      "Edit(sidecar-blockchain/**)",
      "Edit(infra/**)",
      "Edit(scripts/**)",
      "Edit(c:/projects/Escrow/**)",
      "Edit(C:/projects/Escrow/**)",
      "Edit(c:\\projects\\Escrow\\**)",
      "Edit(C:\\projects\\Escrow\\**)",
      "Edit(.claude/memory/MEMORY.md)",
      "Edit(c:/projects/Escrow/.claude/memory/MEMORY.md)",
      "Edit(C:/projects/Escrow/.claude/memory/MEMORY.md)",
      "Edit(c:\\projects\\Escrow\\.claude\\memory\\MEMORY.md)",
      "Edit(C:\\projects\\Escrow\\.claude\\memory\\MEMORY.md)",
      "Edit(C:/Users/teknodeveloper/.claude/projects/c--projects-Escrow/memory/**)",
      "Edit(C:\\Users\\teknodeveloper\\.claude\\projects\\c--projects-Escrow\\memory\\**)",
      "Write(C:/Users/teknodeveloper/.claude/projects/c--projects-Escrow/memory/**)",
      "Write(C:\\Users\\teknodeveloper\\.claude\\projects\\c--projects-Escrow\\memory\\**)",
      "Write(.claude/**)",
      "Write(Docs/**)",
      "Write(backend/**)",
      "Write(frontend/**)",
      "Write(sidecar-steam/**)",
      "Write(sidecar-blockchain/**)",
      "Write(infra/**)",
      "Write(scripts/**)",
      "Write(c:/projects/Escrow/**)",
      "Write(C:/projects/Escrow/**)",
      "Write(c:\\projects\\Escrow\\**)",
      "Write(C:\\projects\\Escrow\\**)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(gh run:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet restore:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Item:*)",
      "PowerShell(dotnet test:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(dotnet format --verify-no-changes:*)",
      "PowerShell(Set-Location c:/projects/Escrow/frontend; npx tsc --noEmit:*)",
      "PowerShell(git diff main...HEAD -- 'Backend/src/Skinora.Shared/Persistence/SystemSettingSeed.cs' | Out-String)",
      "PowerShell(git diff main...HEAD -- 'Docs/06_DATA_MODEL.md' | Out-String)",
      "PowerShell(dotnet test tests/Skinora.API.Tests/Skinora.API.Tests.csproj --filter \"FullyQualifiedName~AdminRbacEndpointTests\" --nologo --verbosity quiet 2>&1)",
      "PowerShell(gh pr view 81 --json mergeCommit,title,state,mergedAt)",
      "PowerShell(git add Docs/IMPLEMENTATION_STATUS.md)",
      "PowerShell(git checkout -b task/T59-emergency-hold)",
      "PowerShell(dotnet build backend/Skinora.sln -c Release --nologo /clp:Summary 2>&1)",
      "PowerShell(dotnet format backend/Skinora.sln --verify-no-changes --no-restore 2>&1)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File ~/.claude/hooks/notify.ps1 -Message 'Claude finished — check the response'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File ~/.claude/hooks/notify.ps1 -Message 'Claude needs your attention'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/post-merge-ci-reminder.ps1",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/powershell-allow.ps1",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
