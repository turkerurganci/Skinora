#!/usr/bin/env bash
# Skinora pre-commit hook — secret leak guard
#
# Amac (2026-07-28, gercek-konfigurasyon provasi): .gitignore tek basina
# yeterli degil. `git add -f`, yanlis dizine yazilmis bir dosya veya bir
# ornek/dokuman icine yapistirilmis gercek deger sirlari repo'ya sokabilir.
# Bu hook staged icerigi commit ANINDA tarar — push'u degil, commit'i bloklar,
# boylece sir hic bir zaman lokal gecmise de yazilmaz (reflog temizligi
# gerekmez).
#
# Iki katman:
#   Layer 1 (yol): secrets/ altindaki README.md disi her sey, .env
#                  (.env.example haric), *.maFile
#   Layer 2 (icerik): Tron private key (64-hex), BIP-39 mnemonic (12/24
#                  kelime), Steam Web API key, gercek deger atanmis
#                  bilinen sir anahtarlari, PEM private key blogu
#
# Davranis:
#   - Bulgu varsa -> BLOCK + exit 1 (dosya + kural adi + satir no yazilir)
#   - SKINORA_ALLOW_SECRET=1 -> WARN + BYPASS_LOG'a kayit + izin verir
#
# Kurulum: bash scripts/git-hooks/install.sh (core.hooksPath mekanizmasi —
# bu dosya oraya konuldugu icin ek adim gerekmez).
#
# Bypass (gercekten placeholder oldugundan eminsen):
#   SKINORA_ALLOW_SECRET=1 SKINORA_BYPASS_REASON="..." git commit -m "..."
#
# Test:
#   printf 'HOT_WALLET_PRIVATE_KEY=%s\n' "$(printf 'a%.0s' {1..64})" > /tmp/x.env
#   cp /tmp/x.env leak.txt && git add leak.txt && git commit -m "test"
#   # beklenen: BLOCK

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo '')"
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi

log_bypass() {
  local LOG_FILE="$REPO_ROOT/Docs/BYPASS_LOG.md"
  if [ -f "$LOG_FILE" ]; then
    local TIMESTAMP GIT_USER BRANCH REASON
    TIMESTAMP="$(date -u '+%Y-%m-%d %H:%M UTC')"
    GIT_USER="$(git config user.name || echo 'unknown')"
    BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo 'detached')"
    REASON="${SKINORA_BYPASS_REASON:-*(sebep belirtilmedi)*}"
    echo "| $TIMESTAMP | $GIT_USER | $BRANCH | \`pending\` | [secret-guard] $REASON |" >> "$LOG_FILE"
    echo "BYPASS LOG: Docs/BYPASS_LOG.md'ye kayit eklendi (secret-guard)." >&2
    echo "  Lutfen bir sonraki normal commit'te bu dosyayi da commit'le." >&2
  fi
}

# Staged (added/copied/modified/renamed) dosyalar — silinenler taranmaz.
STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "$STAGED" ]; then
  exit 0
fi

FINDINGS=""

add_finding() {
  # $1 = dosya, $2 = kural, $3 = detay
  FINDINGS="${FINDINGS}  - ${1}: ${2}${3:+ (${3})}
"
}

# ----------------------------------------------------------------------------
# Layer 1 — yol bazli
# ----------------------------------------------------------------------------
while IFS= read -r file; do
  [ -z "$file" ] && continue
  case "$file" in
    secrets/README.md)
      : # tek izinli secrets/ dosyasi
      ;;
    secrets/*)
      add_finding "$file" "secrets/ altindaki dosyalar commit'lenemez" "yalniz secrets/README.md izinli"
      ;;
    .env.example)
      : # sablon — izinli
      ;;
    .env|.env.*|*/.env|*/.env.*)
      add_finding "$file" ".env dosyalari commit'lenemez" "yalniz .env.example izinli"
      ;;
    *.maFile|*.mafile)
      add_finding "$file" "Steam Mobile Authenticator dosyasi" "sharedSecret/identitySecret aciktan"
      ;;
  esac
done <<EOF
$STAGED
EOF

# ----------------------------------------------------------------------------
# Layer 2 — icerik bazli (yalniz eklenen satirlar)
# ----------------------------------------------------------------------------
# Placeholder'lari elemek icin ortak beyaz liste: .env.example ve dokumanlardaki
# ornek degerler "your_...", "REPLACE_IN_ENV", "changeme", "<...>", "xxx..."
# gibi kaliplar tasir. Bunlar bulgu sayilmaz.
is_placeholder() {
  # "your_x" ve "YourStrong!Password123" gibi tiresiz varyanti da kapsar (^your).
  # "your" tiresiz/gomulu de gecerli (YourStrong!Password123 — connection string
  # icinde), "e2e" tiresiz de (E2e!Strong!Pass!2345 — docker-compose.e2e.yml'in
  # bilincli sabit test degerleri; dosya kendisi "NOT sensitive" diye isaretli).
  echo "$1" | grep -qiE 'your|replace_in_env|changeme|change_me|example|placeholder|<[^>]+>|xxxx|\.\.\.|e2e|test-|fake-|dummy|todo'
}

for file in $STAGED; do
  # Binary / buyuk dosyalari atla
  [ -f "$file" ] || continue
  if ! git diff --cached --numstat -- "$file" | grep -qv '^-' 2>/dev/null; then
    continue
  fi

  ADDED="$(git diff --cached -U0 -- "$file" | grep '^+' | grep -v '^+++' | sed 's/^+//' || true)"
  [ -z "$ADDED" ] && continue

  # Yorum / dokuman satirlari: GENERIC_KEYS bir anahtar ADINI anlatan prose'a da
  # carpar ("# JWT_SECRET: en az 32 karakter olmali"). Deger atamalarini bunlardan
  # ayirmak icin yorum onekli satirlari icerik taramasindan dusuruyoruz — yol
  # katmani (secrets/, .env) zaten bagimsiz calisiyor, yani gercek sir dosyasi
  # yoruma gizlenerek gecemez.
  ADDED_CODE="$(echo "$ADDED" | grep -vE '^[[:space:]]*(#|//|\*|>|--|;)' || true)"

  # 1) Tron/EVM private key — 64 hex karakter, kelime sinirlari icinde
  HITS="$(echo "$ADDED" | grep -oiE '\b[0-9a-f]{64}\b' | head -3 || true)"
  if [ -n "$HITS" ]; then
    while IFS= read -r hit; do
      [ -z "$hit" ] && continue
      # Tek karakterin tekrari (aaaa... / 0000...) test fixture'idir, gercek key degil
      if echo "$hit" | grep -qE '^(.)\1{63}$'; then continue; fi
      add_finding "$file" "64-hex private key kalibi" "${hit:0:8}..."
      break
    done <<EOF
$HITS
EOF
  fi

  # 2) PEM private key blogu
  if echo "$ADDED" | grep -qE 'BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY'; then
    add_finding "$file" "PEM private key blogu" ""
  fi

  # 3) BIP-39 mnemonic — 12 veya 24 ardisik kucuk-harf kelime
  MNEMONIC="$(echo "$ADDED" | grep -oE '\b([a-z]{3,8} ){11}[a-z]{3,8}\b' | head -1 || true)"
  if [ -n "$MNEMONIC" ] && ! is_placeholder "$MNEMONIC"; then
    add_finding "$file" "BIP-39 mnemonic kalibi (12/24 kelime)" "$(echo "$MNEMONIC" | cut -c1-20)..."
  fi

  # 4) Bilinen sir anahtarlarina gercek deger atanmasi
  #    KEY=deger / "KEY": "deger" / KEY: deger formlarini yakalar.
  # Two tiers. NAMED covers this project's exact keys; GENERIC catches the same
  # value pasted under any other name — the gap that let a bare
  #   password: <redacted>
  # (the Steam bot account's real password) through into a task report or README
  # while secrets/steam-bots.json itself was protected only by the path rule.
  # T133 dogrulama turu: the literal was REDACTED here. Quoting a live secret to
  # document the rule that forbids quoting live secrets defeats the rule — and it
  # sat in a TRACKED file, so the value is in git history regardless of this edit.
  # The account is retired (no bot layer since T133) but the password must still
  # be rotated — see secrets/README.md.
  NAMED_KEYS='HOT_WALLET_PRIVATE_KEY|HD_WALLET_MNEMONIC|STEAM_API_KEY|TRON_API_KEY|TRON_API_KEY_SECONDARY|JWT_SECRET|WEBHOOK_SECRET|BLOCKCHAIN_WEBHOOK_SECRET|INTERNAL_KEY|STEAM_SIDECAR_INTERNAL_KEY|BLOCKCHAIN_SIDECAR_INTERNAL_KEY|MSSQL_SA_PASSWORD|REDIS_PASSWORD|TELEGRAM_BOT_TOKEN|GRAFANA_ADMIN_PASSWORD|sharedSecret|identitySecret'
  GENERIC_KEYS='[A-Za-z_]*(PASSWORD|PASSWD|SECRET|API_?KEY|ACCESS_?KEY|PRIVATE_?KEY|CLIENT_?SECRET|CONNECTION_?STRING)[A-Za-z_]*'
  SECRET_KEYS="$NAMED_KEYS|$GENERIC_KEYS"
  # Parca degil TAM SATIR uzerinden calisiyoruz. Bir onceki surum degeri karakter
  # sinifiyla kesiyordu; connection string'ler hem virgul hem BOSLUK icerdigi icin
  # ("Server=db,1433;User Id=sa;Password=REPLACE_IN_ENV") placeholder isareti
  # kesilen kuyrukta kaliyor ve sablon dosyalari yanlis pozitif veriyordu.
  ASSIGN_LINES="$(echo "$ADDED_CODE" \
    | grep -inE "($SECRET_KEYS)[\"']?[[:space:]]*[:=][[:space:]]*[\"']?[^[:space:]]{8,}" \
    | cut -d: -f2- || true)"
  if [ -n "$ASSIGN_LINES" ]; then
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      # Placeholder / env-indirection kontrolu TUM satirda: kesilme yok, gomulu
      # isaretler (REPLACE_IN_ENV, YourStrong!, E2e!) guvenilir sekilde gorulur.
      if is_placeholder "$line"; then continue; fi
      # ${VAR} / $VAR referansi deger degil.
      if echo "$line" | grep -qE '\$\{?[A-Za-z_]'; then continue; fi
      VALUE="$(echo "$line" | sed -E "s/^.*($SECRET_KEYS)[\"']?[[:space:]]*[:=][[:space:]]*[\"']?//I")"
      # GENERIC_KEYS kod bildirimlerine de carpar (C# property, TS tip alani).
      if echo "$VALUE" | grep -qE '^(get;|set;|string\.|null|true|false|\{)'; then continue; fi
      # Kod dosyasinda TIRNAKSIZ property-access/degisken referansi bir sir DEGERI
      # degil, kodun kendisidir:
      #   bot.sharedSecret = response.shared_secret;
      #   client.logOn({ accountName: bot.accountName, password: bot.password });
      # Eleme dar tutuldu: deger BASTAN SONA identifier zinciri olmali ve yalniz
      # kod noktalamasi (; , ) } ]) ile bitebilmeli. Hardcode'lanmis gercek bir sir
      # tirnak tasir ("abc123") -> kapanis tirnagi bu kalibin disinda kalir ve
      # bulgu olarak yakalanmaya devam eder.
      case "$file" in
        *.ts|*.tsx|*.js|*.jsx|*.cjs|*.mjs|*.cs)
          if echo "$VALUE" | grep -qE '^[A-Za-z_$][A-Za-z0-9_$]*(\.[A-Za-z_$][A-Za-z0-9_$]*)+[[:space:];,)}]*$'; then continue; fi
          ;;
      esac
      KEY="$(echo "$line" | grep -oiE "($SECRET_KEYS)" | head -1)"
      add_finding "$file" "sir anahtarina gercek deger: $KEY" "${VALUE:0:6}..."
      break
    done <<EOF
$ASSIGN_LINES
EOF
  fi
done

# ----------------------------------------------------------------------------
# Sonuc
# ----------------------------------------------------------------------------
if [ -z "$FINDINGS" ]; then
  exit 0
fi

if [ "$SKINORA_ALLOW_SECRET" = "1" ]; then
  echo "" >&2
  echo "UYARI: pre-commit secret guard BYPASS edildi (SKINORA_ALLOW_SECRET=1)." >&2
  echo "Bulgular:" >&2
  printf '%s' "$FINDINGS" >&2
  log_bypass
  exit 0
fi

echo "" >&2
echo "=============================================================" >&2
echo " COMMIT BLOKLANDI — staged icerikte sir kalibi bulundu" >&2
echo "=============================================================" >&2
printf '%s' "$FINDINGS" >&2
echo "" >&2
echo "Ne yapmali:" >&2
echo "  1. Deger bir SIR ise: dosyayi unstage et (git restore --staged <dosya>)," >&2
echo "     degeri .env veya secrets/ altina tasi (ikisi de gitignored)." >&2
echo "  2. Deger gercekten PLACEHOLDER ise: 'your_...' / 'REPLACE_IN_ENV'" >&2
echo "     gibi taninan bir kalip kullan, ya da bilincli bypass et:" >&2
echo "     SKINORA_ALLOW_SECRET=1 SKINORA_BYPASS_REASON=\"...\" git commit ..." >&2
echo "" >&2
echo "Detay: secrets/README.md" >&2
exit 1
