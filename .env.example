# =============================================================================
# Skinora — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# --- General ---
NODE_ENV=development
ASPNETCORE_ENVIRONMENT=Development

# --- Backend (.NET) ---
BACKEND_PORT=5000

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
# SignalR hub base URL (T96). The trailing /hubs segment is appended by the
# client (`createHubConnection` in lib/signalr/connection.ts). Defaults to
# the same origin when unset — set explicitly when the frontend and backend
# are served from different origins.
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs

# --- SQL Server ---
DB_PORT=1433
MSSQL_SA_PASSWORD=YourStrong!Password123
MSSQL_PID=Developer
DB_CONNECTION_STRING=Server=skinora-db,1433;Database=Skinora;User Id=sa;Password=YourStrong!Password123;TrustServerCertificate=True;

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=YourRedisPassword123
REDIS_CONNECTION_STRING=skinora-redis:6379,password=YourRedisPassword123

# --- Nginx ---
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# --- Steam Sidecar ---
STEAM_SIDECAR_PORT=5100
STEAM_SIDECAR_BACKEND_URL=http://skinora-backend:5000
STEAM_API_KEY=your_steam_api_key_here

# --- Webhook (T68) ---
# HMAC-SHA256 shared secret between Steam sidecar → backend webhook
# (05 §3.4, 09 §11.3). Min 32 characters of cryptographic randomness.
WEBHOOK_SECRET=your_webhook_hmac_secret_minimum_32_characters_long

# --- Blockchain Sidecar ---
BLOCKCHAIN_SIDECAR_PORT=5200
BLOCKCHAIN_SIDECAR_BACKEND_URL=http://skinora-backend:5000
TRON_NETWORK=nile
TRON_FULL_NODE_URL=https://nile.trongrid.io
HD_WALLET_MNEMONIC=your_hd_wallet_mnemonic_here

# --- Observability (T08) ---
LOKI_PORT=3100
LOKI_URL=http://skinora-loki:3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Monitoring (T16) ---
PROMETHEUS_PORT=9090
UPTIME_KUMA_PORT=3002

# --- Alerting (T16) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ALERT_EMAIL_TO=admin@skinora.com

# --- JWT ---
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_ISSUER=skinora
JWT_AUDIENCE=skinora-client
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- Internal API key (backend ↔ sidecar) ---
# Shared X-Internal-Key for backend → sidecar internal API auth (05 §3.4).
INTERNAL_KEY=your_internal_api_key_here

# =============================================================================
# Mandatory SystemSettings (19) — see Docs/DEPLOY_RUNBOOK.md §A
# -----------------------------------------------------------------------------
# These 19 SystemSetting rows ship UNCONFIGURED (no seed default). The backend
# SettingsBootstrapService hydrates them from these env vars at startup and
# FAIL-FAST (InvalidOperationException, container exit) if any is missing or
# fails type/range validation. Already-configured rows (set via the admin UI)
# are NOT overridden by env (06 §8.9). Values below mirror the test fixture;
# set real production values deliberately by risk profile.
# =============================================================================
SKINORA_SETTING_ACCEPT_TIMEOUT_MINUTES=60
SKINORA_SETTING_TRADE_OFFER_SELLER_TIMEOUT_MINUTES=60
SKINORA_SETTING_PAYMENT_TIMEOUT_MIN_MINUTES=15
SKINORA_SETTING_PAYMENT_TIMEOUT_MAX_MINUTES=60
SKINORA_SETTING_PAYMENT_TIMEOUT_DEFAULT_MINUTES=30
SKINORA_SETTING_TRADE_OFFER_BUYER_TIMEOUT_MINUTES=60
SKINORA_SETTING_MIN_TRANSACTION_AMOUNT=1.0
SKINORA_SETTING_MAX_TRANSACTION_AMOUNT=10000.0
SKINORA_SETTING_MAX_CONCURRENT_TRANSACTIONS=5
SKINORA_SETTING_NEW_ACCOUNT_TRANSACTION_LIMIT=3
SKINORA_SETTING_NEW_ACCOUNT_PERIOD_DAYS=14
SKINORA_SETTING_CANCEL_LIMIT_COUNT=3
SKINORA_SETTING_CANCEL_LIMIT_PERIOD_HOURS=24
SKINORA_SETTING_CANCEL_COOLDOWN_HOURS=1
SKINORA_SETTING_HIGH_VOLUME_AMOUNT_THRESHOLD=5000.0
SKINORA_SETTING_HIGH_VOLUME_COUNT_THRESHOLD=10
SKINORA_SETTING_HIGH_VOLUME_PERIOD_HOURS=24
SKINORA_SETTING_HOT_WALLET_LIMIT=100000.0
SKINORA_SETTING_DORMANT_ACCOUNT_VALUE_THRESHOLD=1000.0

# --- Recommended for production (NONE default → scope skipped) — DEPLOY_RUNBOOK §C
# SKINORA_SETTING_RECONCILIATION_HOT_WALLET_ADDRESS=
# SKINORA_SETTING_RECONCILIATION_COLD_WALLET_ADDRESS=

# =============================================================================
# Sidecar cadence / sweep parity — see Docs/DEPLOY_RUNBOOK.md §D
# -----------------------------------------------------------------------------
# These live in BOTH the backend SystemSetting catalog (admin visibility) AND
# the blockchain sidecar env. The sidecar reads its OWN env at boot — changing
# the backend SystemSetting does NOT propagate to a running sidecar (T74 K1 /
# T96 deferred). To change a cadence: update the sidecar env below AND restart
# the sidecar; keep the backend SystemSetting in parity for admin visibility.
# =============================================================================
POST_CANCEL_CADENCE_24H_MS=30000
POST_CANCEL_CADENCE_7D_MS=300000
POST_CANCEL_CADENCE_30D_MS=3600000
SWEEP_ENERGY_DELEGATION_SUN=200000000
SWEEP_TRX_FALLBACK_SUN=15000000
