# =============================================================================
# Skinora — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# --- General ---
NODE_ENV=development
ASPNETCORE_ENVIRONMENT=Development

# --- Backend (.NET) ---
BACKEND_PORT=5000

# --- Public origin ---
# The single browser-facing origin. nginx (skinora-reverse-proxy) serves the
# frontend and proxies /api + /hubs + /health to the backend, so one origin is
# enough — this is what you open in the browser and what Steam OpenID and CORS
# are configured against. Must match NGINX_HTTP_PORT below.
PUBLIC_ORIGIN=http://localhost:8080

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# NOTE: NEXT_PUBLIC_* are inlined by Next.js at BUILD time and the frontend
# Dockerfile takes no build args — setting these at runtime in docker-compose
# has NO effect on the built image. The image is built with the same-origin
# defaults ("/api/v1" in lib/api/client.ts, "/hubs" in lib/signalr/connection.ts),
# which is exactly what the nginx single-origin setup needs. Only set these when
# you rebuild the frontend image for a split-origin deployment.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SIGNALR_URL=

# --- SQL Server ---
DB_PORT=1433
MSSQL_PID=Developer
# T171b — the sa password is NOT here: it is the Docker secret file
# secrets/mssql_sa_password.txt, read by the database, the backup container
# and the backend (secrets/README.md, DEPLOY_RUNBOOK §L.9). The connection
# string carries NO password — the backend adds the file's at start; outside
# Development a Password= here stops it (CREDENTIAL_IN_ENV).
DB_CONNECTION_STRING=Server=skinora-db,1433;Database=Skinora;User Id=sa;TrustServerCertificate=True;

# --- Database backup (T164, DEPLOY_RUNBOOK §N) ---
# skinora-db-backup: full every N hours, log every N minutes (0 = no log
# backups, recovery SIMPLE), files older than N days pruned (the newest two
# fulls always stay). Files land in DB_BACKUP_HOST_DIR on the host (gitignored;
# personal data — keep the folder private). The trial overlay ignores
# DB_BACKUP_HOST_DIR and uses backups/trial/db (or TRIAL_DB_BACKUP_DIR).
DB_BACKUP_HOST_DIR=./backups/db
DB_BACKUP_FULL_INTERVAL_HOURS=24
DB_BACKUP_LOG_INTERVAL_MINUTES=15
DB_BACKUP_RETENTION_DAYS=14

# --- Redis ---
REDIS_PORT=6379
# T171b — the password is the Docker secret file secrets/redis_password.txt
# (Redis, backend, Steam service; only A-Z a-z 0-9 . _ ~ + = -,
# openssl rand -hex 32). The connection string carries NO password.
REDIS_CONNECTION_STRING=skinora-redis:6379

# --- Nginx ---
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
# T161 — host address the edge binds. Default 127.0.0.1 (this machine only).
# Every OTHER host port in docker-compose.yml is bound to 127.0.0.1 with no
# knob. Set 0.0.0.0 ONLY on a server that serves 80/443 directly
# (DEPLOY_RUNBOOK §K.6) — on Linux Docker's iptables rules bypass ufw.
NGINX_BIND_ADDRESS=127.0.0.1

# --- Trial deployment (T161, DEPLOY_RUNBOOK §K) ---
# Read only by docker-compose.trial.yml (`--env-file .env.trial`). The trial
# publishes no internal port; these three are loopback-only operator ports.
# The trial network (172.30.161.0/24) and the tunnel connector's address
# (172.30.161.250) are fixed in docker-compose.trial.yml and nginx/nginx.conf
# (T162) — there is no variable for them.
TRIAL_HTTP_PORT=8090
TRIAL_GRAFANA_PORT=3011
TRIAL_UPTIME_KUMA_PORT=3012
# The tunnel token is NOT here: it is a Docker secret file,
# secrets/trial/cloudflare_tunnel_token.txt (secrets/README.md).

# --- Steam authentication (OpenID 2.0 + Web API) — 08 §2.1, §2.2 ---
# Steam redirects the user's browser back to RETURN_TO after consent, so these
# must be reachable from the browser (localhost is fine). The appsettings.json
# defaults point at https://getskinora.com — override them or real login breaks.
# The trial (.env.trial, T162): https://getskinora.com for all four.
STEAM_OPENID_REALM=http://localhost:8080
STEAM_OPENID_RETURN_TO=http://localhost:8080/api/v1/auth/steam/callback
STEAM_OPENID_REVERIFY_RETURN_TO=http://localhost:8080/api/v1/auth/steam/re-verify/callback
STEAM_OPENID_FRONTEND_CALLBACK=http://localhost:8080/auth/callback

# --- Steam Sidecar ---
STEAM_SIDECAR_PORT=5100
STEAM_SIDECAR_BACKEND_URL=http://skinora-backend:5000
# Steam Web API key — https://steamcommunity.com/dev/apikey
# Used by the sidecar (inventory) and by the backend (OpenID profile name/avatar;
# when empty login still succeeds but the profile falls back to a placeholder).
# T171b — the key is the Docker secret file secrets/steam_api_key.txt, not a
# variable (both services read the same file; secrets/README.md).
# This key is the sidecar's ONLY Steam credential (T133). Escrow bot credentials
# (STEAM_BOTS_CONFIG_PATH / STEAM_BOTS_JSON) were removed with the custody layer:
# the platform runs no Steam account and sends no trade offers (05 §3.2).
# Inventory cache (08 §2.3). Empty → in-memory fallback (dev/test only).
# T171b — NO password in the URL: the service adds secrets/redis_password.txt.
STEAM_SIDECAR_REDIS_URL=redis://skinora-redis:6379
# Steam Community inventory endpoint rate limit, requests/minute (08 §2.6, T120).
# Valve documents no limit; community observation puts it at 10-20/min per IP and
# overshooting is punished with an IP block. Empty → 10/min. Each delivery
# verification costs two reads (seller + buyer), so this value is also the ceiling
# on concurrent verifications. Raise it only behind a proxy pool, or after T122
# measures the real limit. Requires a sidecar restart to take effect.
STEAM_SIDECAR_COMMUNITY_REQUESTS_PER_MINUTE=10
# Limited-account probe (08 §2.2a) — the same Steam Community budget above.
# `0` (not limited) is only accepted after this many consecutive samples, taken
# SAMPLE_DELAY_MS apart, because the profile document has been measured lying in
# exactly that direction. The default 3 is BELOW the 5 consecutive reads the
# manual procedure in DEPLOY_RUNBOOK §G.5 requires, and deliberately so: the
# manual rule runs once, this one spends a Community request per sample for
# every cold user. Raise it here once the real per-IP limit is measured — no
# rebuild needed, but the sidecar must be restarted. Empty → 3 / 3000 / 20000.
STEAM_SIDECAR_LIMITED_ACCOUNT_SAMPLES=
STEAM_SIDECAR_LIMITED_ACCOUNT_SAMPLE_DELAY_MS=
# Ceiling for the whole check. Must stay BELOW the backend client's 30s timeout,
# otherwise a slow queue surfaces as "backend timeout" instead of a coded 503.
STEAM_SIDECAR_LIMITED_ACCOUNT_DEADLINE_MS=
# How long a CONFIRMED CLEAN result is cached (24h by default). Limited results
# and failures are never cached — a blocking answer is always read live.
STEAM_SIDECAR_LIMITED_ACCOUNT_CACHE_TTL_SECONDS=

# --- Webhook (T68) ---
# T171a — NOT here any more. The HMAC secret of the TRON service's webhooks
# (05 §3.4, 09 §11.3) is the Docker secret file secrets/blockchain_webhook_secret.txt,
# read by the backend AND the TRON service (>= 32 characters, openssl rand -hex 32).
# WEBHOOK_SECRET / BLOCKCHAIN_WEBHOOK_SECRET in .env are not passed to any
# container; outside development a service refuses to start on such a
# variable (SHARED_SECRET_IN_ENV). See secrets/README.md for the move.

# --- Blockchain Sidecar ---
BLOCKCHAIN_SIDECAR_PORT=5200
BLOCKCHAIN_SIDECAR_BACKEND_URL=http://skinora-backend:5000
TRON_NETWORK=nile
TRON_FULL_NODE_URL=https://nile.trongrid.io
# TronGrid API key — https://www.trongrid.io (free tier). Without it TronGrid
# rate-limits (429) the payment monitor. SECONDARY enables key failover (WP10);
# keys of the SAME TronGrid account may share one quota, so a secondary key adds
# budget only if it belongs to another account (DEPLOY_RUNBOOK §B).
# T171b — both keys are Docker secret files: secrets/tron_api_key.txt and
# secrets/tron_api_key_secondary.txt (empty file = no key; secrets/README.md).
# The plan's daily request budget — the tron-quota-projection alert warns when
# the measured request rate would use 80% of it. 100000 = the free tier as
# reported in 2026; set the real plan's figure (DEPLOY_RUNBOOK §B).
TRONGRID_DAILY_REQUEST_BUDGET=100000
# T170 — chain progress: the TRON service reads the solid head every
# TRON_SOLID_BLOCK_POLL_INTERVAL_MS (60 s = 1,440 TronGrid requests a day) and
# the tron-solid-block-stalled alarm fires when the head is older than
# TRON_SOLID_BLOCK_STALL_SECONDS (300; normal ~60 s). DEPLOY_RUNBOOK §P.7.
TRON_SOLID_BLOCK_POLL_INTERVAL_MS=60000
TRON_SOLID_BLOCK_STALL_SECONDS=300
# How often a deposit address is polled once its payment is confirmed (until the
# sweep, ~8 days). The payment itself is still polled every
# PAYMENT_POLLING_INTERVAL_MS (3 s). 900000 = 15 min (08 §3.4).
PAYMENT_HOLDING_POLLING_INTERVAL_MS=900000
# TRC-20 token contracts (08 §3.3). MAINNET addresses are hardcoded in the
# sidecar; on nile/shasta they MUST be supplied here or the supported-token
# allowlist is empty and every incoming transfer is classified wrong/spam token.
# These same two values are also passed to the BACKEND as
# StablecoinContracts__Usdt / __Usdc (see docker-compose.yml). Both halves must
# agree: the backend arms the monitor with expectedContract and the sidecar
# compares the incoming transfer against it, so a mismatch makes a correct
# payment look like the wrong token and routes it to auto-refund.
TRON_USDT_CONTRACT=
TRON_USDC_CONTRACT=
# Block explorer the frontend links transaction hashes to. Build-time value
# (see docker-compose.yml `build.args`) — changing it requires rebuilding the
# frontend image. Empty = mainnet tronscan.org. On nile:
# https://nile.tronscan.org/#/transaction/
TRONSCAN_TX_BASE_URL=
# T156 — the same for Ethereum transaction links. Empty = mainnet etherscan.io.
# On Sepolia: https://sepolia.etherscan.io/tx/
ETHERSCAN_TX_BASE_URL=
# T163 — the TRON HD seed (deposit addresses, 08 §3.2, m/44'/195'/0'/0/{index})
# and the hot wallet PRIVATE KEY are NOT set here any more. They are Docker
# secret files, mounted into the blockchain sidecar alone:
#   secrets/tron_hd_mnemonic.txt             (trial: secrets/trial/...)
#   secrets/tron_hot_wallet_private_key.txt
# (secrets/README.md; offline backup DEPLOY_RUNBOOK §L). Outside
# NODE_ENV=development|test the sidecar REFUSES to start when HD_WALLET_MNEMONIC
# or HOT_WALLET_PRIVATE_KEY is set as a variable (SIGNING_SECRET_IN_ENV).
# Hot wallet — operationally distinct from the HD master (05 §3.3, §3.5).
# Signs SELLER_PAYOUT / refund / sweep. Its public ADDRESS stays here; when the
# key file is filled, the key must control this address
# (HOT_WALLET_ADDRESS_MISMATCH).
HOT_WALLET_ADDRESS=
# Cold wallet the hot→cold consolidation may credit (05 §3.3, AD20). Empty =
# consolidation disabled. Both addresses go to the backend AND the sidecar:
# the sidecar refuses to sign to anything else, the backend only records them.
COLD_WALLET_ADDRESS=
# Outbound ceilings enforced by the signer (08 §3.3a, DEPLOY_RUNBOOK §C.3).
# Decimal USDT. FAIL-CLOSED: while these are empty the sidecar refuses every
# payout and refund. Single = largest allowed transaction; daily = expected
# daily payout volume × 3 (hot→cold consolidation is exempt).
# T169 (öneriyle kaydedildi — ⚠, re-asked before mainnet): single 3000 = the
# largest refund (2900 × 1.02 + network fee line, rounded up); daily 9000 =
# three largest sales. Same values per network (ETHEREUM_MAX_* below).
MAX_SINGLE_TRANSFER_USDT=3000
MAX_DAILY_OUTFLOW_USDT=9000
# T172b (proje sahibi kararı 2026-10-23) — the signer's own 24-hour cap on
# refunds leaving deposits (the cap above only sees the hot wallet). Decimal
# USDT, USDC counted 1:1, rolling 24 h. FAIL-CLOSED: empty or malformed → no
# deposit refund is signed; it waits (PENDING) and the alarm
# tron-deposit-refund-limit-refused fires. Same value as the backend setting
# blockchain.tron.deposit_refund_daily_limit_usdt (T169a). A single refund
# above it never goes out on its own — raise it deliberately (DEPLOY_RUNBOOK §D).
DEPOSIT_REFUND_DAILY_LIMIT_USDT=100
# --- Ethereum service (T148 contract, T150 service — 05 §3.3a, 08 §3.7) ---
# Every network has its own service, internal key, webhook secret, token
# contracts and wallet pair. The webhook secret MUST differ from
# BLOCKCHAIN_WEBHOOK_SECRET (a shared secret would let either service speak
# for the other). Empty contracts = Ethereum mainnet USDT / USDC.
#
# The service runs only under the compose profile "ethereum"
# (`docker compose -f docker-compose.yml --profile ethereum up -d`) and only
# with its Docker secrets in place (secrets/README.md, DEPLOY_RUNBOOK §B).
# BACKEND side: the service is complete (T151 monitoring, T152 sending, T153
# fuel, T154 fee estimate). Setting ETHEREUM_SIDECAR_BASE_URL OPENS Ethereum
# to new transactions — do it only through the opening checklist of
# DEPLOY_RUNBOOK §J (secrets, RPC keys, price-source probe
# scripts/probe-eth-price-sources.sh, funded wallets, alarms). Empty = every
# Ethereum call fails closed and TRON is untouched.
# To open: ETHEREUM_SIDECAR_BASE_URL=http://skinora-ethereum-sidecar:5300
ETHEREUM_SIDECAR_BASE_URL=
# T171a — the Ethereum internal key and webhook secret are Docker secret files:
# secrets/ethereum_sidecar_internal_key.txt and secrets/ethereum_webhook_secret.txt
# (>= 32 characters each, different from the TRON ones; secrets/README.md).
ETHEREUM_USDT_CONTRACT=
ETHEREUM_USDC_CONTRACT=
ETHEREUM_HOT_WALLET_ADDRESS=
ETHEREUM_COLD_WALLET_ADDRESS=
# Chain: sepolia (chainId 11155111, default) or mainnet (chainId 1).
ETHEREUM_NETWORK=sepolia
ETHEREUM_SIDECAR_PORT=5300
# JSON-RPC providers (08 §3.7.1): primary Alchemy Free, backup Chainstack
# Developer. The URLs carry the API keys — T171b: they are Docker secret
# files, secrets/ethereum_rpc_primary_url.txt and
# secrets/ethereum_rpc_backup_url.txt (secrets/README.md), not variables. The
# primary is required (the service does not start without it). Per-provider
# eth_getLogs limits (08 §3.7.4): Alchemy Free 10 blocks, Chainstack
# Developer 100 blocks, 1,000 addresses per search position.
ETHEREUM_RPC_PRIMARY_NAME=alchemy
ETHEREUM_RPC_PRIMARY_MAX_BLOCK_RANGE=10
ETHEREUM_RPC_PRIMARY_MAX_ADDRESSES=1000
ETHEREUM_RPC_BACKUP_NAME=chainstack
ETHEREUM_RPC_BACKUP_MAX_BLOCK_RANGE=100
ETHEREUM_RPC_BACKUP_MAX_ADDRESSES=1000
# Finalized head: read every 30 s; older than 30 min = unhealthy + alarm
# (08 §3.7.4, §3.7.8). Keep the backend's blockchain.ethereum.finality_stall_alarm_minutes
# in parity (DEPLOY_RUNBOOK §D).
ETHEREUM_FINALIZED_POLL_INTERVAL_MS=30000
ETHEREUM_FINALIZED_STALL_SECONDS=1800
# T151 payment monitor (08 §3.7.4): a deposit re-armed after a restart is read
# back this many blocks (7,200 ≈ 24 h). Hourly balance reconciliation, paced
# under the provider limit (Alchemy Free 300 CU/s); a finalized head older than
# 25 min skips the round (state that deep may need archive access).
ETHEREUM_MONITOR_RESTART_LOOKBACK_BLOCKS=7200
ETHEREUM_RECONCILIATION_INTERVAL_MS=3600000
ETHEREUM_RECONCILIATION_CU_PER_SECOND=200
ETHEREUM_RECONCILIATION_MAX_FINALIZED_AGE_SECONDS=1500
# T153 fuel wallet (08 §3.7.5): every Ethereum sweep / refund from a deposit
# is preceded by fuel — exactly the missing gas — from the fuel wallet. Caps in
# ETH; EMPTY = no fuel at all (sweeps and refunds wait FUEL_REQUIRED). Sizing:
# DEPLOY_RUNBOOK §C.3. The ETH floors of the fuel and hot wallets raise
# ethereum-wallet-eth-low; keep them equal to the backend settings
# blockchain.ethereum.{fuel,hot}_wallet_eth_balance_minimum (DEPLOY_RUNBOOK §D).
# T169 (öneriyle kaydedildi — ⚠): 0.001 single (a capped-day fuel is
# ~0.0002 ETH) / 0.02 daily (~99 capped fuels). Exceeded = the job waits.
ETHEREUM_FUEL_MAX_SINGLE_ETH=0.001
ETHEREUM_FUEL_MAX_DAILY_ETH=0.02
# Ethereum outbound ceilings enforced by the Ethereum signer (08 §3.7,
# DEPLOY_RUNBOOK §C.3) — the TRON pair's twin, decimal USDT. FAIL-CLOSED:
# while empty the Ethereum service refuses every payout and refund. T169
# (öneriyle kaydedildi — ⚠, re-asked before mainnet): 3000 / 9000.
ETHEREUM_MAX_SINGLE_TRANSFER_USDT=3000
ETHEREUM_MAX_DAILY_OUTFLOW_USDT=9000
# T172b — the Ethereum signer's 24-hour deposit refund cap (the TRON twin
# above; counted from the transaction journal). FAIL-CLOSED: empty → every
# deposit refund waits. Must equal blockchain.ethereum.deposit_refund_daily_limit_usdt.
ETHEREUM_DEPOSIT_REFUND_DAILY_LIMIT_USDT=100
ETHEREUM_FUEL_WALLET_MIN_ETH=0.06
ETHEREUM_HOT_WALLET_MIN_ETH=0.06
ETHEREUM_WALLET_BALANCE_INTERVAL_MS=300000
# The seed and the two signing keys are NOT here: they are Docker secrets,
# files under secrets/ (ethereum_hd_mnemonic.txt, ethereum_hot_wallet_private_key.txt,
# ethereum_fuel_wallet_private_key.txt) — see secrets/README.md.
# T149 (11 §F8, öneriyle kaydedildi — ⚠) — the hybrid Energy stake is DORMANT.
# On TRON the buyer pays the sweep as a "TRON network fee" line and the seller
# the payout (K4/K8), so the platform does not stake. Only 'true' switches the
# delegation code back on; blank/false = no stake read, no delegation, every
# deposit transfer burns, and the two STAKE_ACCOUNT_* values below are ignored.
# Any other value stops the sidecar at startup.
ENERGY_STAKING_ENABLED=false
# Dedicated stake account holding the frozen TRX for Energy delegation
# (05 §3.3, owner decision 2026-09-17). Blockchain sidecar only. Its OWNER key
# stays offline; the hot wallet key above is listed in an active permission
# that may only delegate and reclaim Energy, so a stolen hot key cannot unstake
# or move this TRX. Empty = the hot wallet holds its own stake. Setup, and the
# permanent delegation of the payout share to the hot wallet: DEPLOY_RUNBOOK §C.2.
STAKE_ACCOUNT_ADDRESS=
# Active-permission id on that account (default 2 — the first id the chain
# assigns; blank also means 2). Ignored while STAKE_ACCOUNT_ADDRESS is empty.
# With it set, an address that is not base58 (T..., so not the 41... hex form)
# or an id that is not an integer >= 2 stops the sidecar at startup. Check the
# "Energy delegation:" line in the sidecar log after a restart.
STAKE_ACCOUNT_PERMISSION_ID=2

# --- Observability (T08) ---
LOKI_PORT=3100
LOKI_URL=http://skinora-loki:3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# T171b — the admin password is the Docker secret file
# secrets/grafana_admin_password.txt (trial: secrets/trial/...), not a
# variable. Grafana does not start without a non-empty file — no `admin`
# fallback any more, in development either (scripts/grafana/first-boot.sh).

# --- Monitoring (T16) ---
PROMETHEUS_PORT=9090
UPTIME_KUMA_PORT=3002
# T158 (a) — PENDING outbound rows per network above which the
# outbound-transfer-backlog alert fires (backend OutboundQueueAlarm__PendingRowsThreshold).
# Default 25 = more than one dispatcher batch (20 per network per minute).
OUTBOUND_PENDING_ROWS_ALARM_THRESHOLD=25

# --- Database restore (T172a — DEPLOY_RUNBOOK §N.8 (b)) ---
# Per-network floor for the next deposit HD index. Leave 0 in normal operation.
# After a restore set it ABOVE the largest index the lost period handed out
# (old copy's MAX + 1000; without the old copy: restored MAX + 10000), before
# the backend starts. A floor at or below the current MAX changes nothing.
# Digits only, no separators: 11234 (NOT 11.234 / 11,234 / 1e4) — anything
# else stops the backend at start-up. The start-up log line
# "Deposit index floor at start-up: TRON = ..., ETHEREUM = ..." shows it.
PAYMENT_ADDRESS_MIN_NEXT_INDEX_TRON=0
PAYMENT_ADDRESS_MIN_NEXT_INDEX_ETHEREUM=0

# --- Alerting (T16) ---
# REQUIRED FOR GRAFANA TO START — not merely for alerts to be delivered.
# infra/grafana/provisioning/alerting/contactpoints.yml declares a Telegram
# contact point, and Grafana provisioning has no conditionals: a declared
# contact point must validate or Grafana aborts startup and the container
# crash-loops. Leave these empty and you get
#   "failed to validate integration telegram-critical: could not find Bot Token"
# Values are substituted into the provisioning tree by the
# skinora-grafana-provisioning render step (see docker-compose.yml) before
# Grafana parses it — Grafana's own ${VAR} interpolation cannot be used here
# because it re-types the value and a numeric chat id then fails the
# integration's string field.
# For a local rehearsal without a real bot, any non-empty values work.
# T165 — ONE Telegram bot for both: the backend sends users' (and admins')
# notifications through it, Grafana sends the operator's alerts to
# TELEGRAM_CHAT_ID through it. TELEGRAM_CHAT_ID: the owner's own chat with the
# bot (or an alert group) — DEPLOY_RUNBOOK §P.3 shows how to read it.
# T171a — the bot token is the Docker secret file secrets/telegram_bot_token.txt
# (backend + this render step). Grafana does not start on an EMPTY token: for a
# local rehearsal put any placeholder there (secrets/README.md).
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ALERT_EMAIL_TO=admin@getskinora.com
# T165 — Grafana's e-mail alerts go out through Resend SMTP
# (smtp.resend.com:587, STARTTLS, user "resend"). The password is a Resend API
# key — create a SEPARATE "Sending access" key for Grafana, not the backend's.
# The trial overlay turns SMTP on; development leaves it off.
GRAFANA_SMTP_ENABLED=false
# T171a — the SMTP password is the Docker secret file secrets/grafana_smtp_password.txt.
GRAFANA_SMTP_FROM_ADDRESS=alerts@getskinora.com

# --- Notification channels (T165, DEPLOY_RUNBOOK §P) ---
# Provider per channel: logging (development stub — messages are only logged),
# resend / telegram / discord (real), disabled (switched off). The TRIAL
# overlay forces the production choice (owner decision 2026-10-21: e-mail +
# Telegram ON, Discord OFF) whatever these say, so in .env.trial only the
# secrets matter. A real provider with an empty / placeholder / malformed
# secret runs "misconfigured": off for users, error in the backend log,
# notification-channel-misconfigured alert. Fill the secrets, restart the backend.
RESEND_PROVIDER=logging
# T171a — the channel SECRETS are Docker secret files, not variables
# (secrets/README.md): secrets/resend_api_key.txt (Resend → API Keys →
# "Sending access", starts with re_), secrets/resend_webhook_signing_secret.txt
# (Resend → Webhooks → signing secret, whsec_…), secrets/telegram_bot_token.txt,
# secrets/telegram_webhook_secret_token.txt (1–256 of A–Z a–z 0–9 _ -;
# openssl rand -hex 32). Empty file = channel "misconfigured".
# Must be on the domain verified in Resend (DKIM/SPF, RESEND_SETUP.md §2).
RESEND_FROM_ADDRESS="Skinora <noreply@getskinora.com>"
TELEGRAM_PROVIDER=logging
# The bot's username without "@" as BotFather registered it (the deep link
# https://t.me/<username> is built from it).
TELEGRAM_BOT_USERNAME=SkinoraBot
DISCORD_PROVIDER=logging

# --- Outside monitor heartbeat (T165, trial only, DEPLOY_RUNBOOK §P.5) ---
# T171a — the Healthchecks.io ping URL (https://hc-ping.com/<uuid>) is the
# Docker secret file secrets/trial/heartbeat_url.txt. Empty = the heartbeat
# container idles. It is a secret: whoever has it can send pings.
# What it checks is fixed in docker-compose.trial.yml (HEARTBEAT_CHECK_URLS,
# not read from here): the edge's /api/health, the front page and Grafana's
# /api/health — the money alarms leave through Grafana, so a Grafana that is
# down or never started stops the pings too (T165 kapanış, ⚠ PARA).
HEARTBEAT_INTERVAL_SECONDS=60
HEARTBEAT_FAILURES_BEFORE_FAIL=3

# --- JWT ---
# T171a — the signing key is the Docker secret file secrets/jwt_secret.txt
# (>= 32 characters, openssl rand -hex 32), not a variable.
JWT_ISSUER=skinora
JWT_AUDIENCE=skinora-client
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- Internal API keys (backend ↔ sidecar) ---
# X-Internal-Key for backend → sidecar internal API auth (05 §3.4). T171a — one
# Docker secret FILE per sidecar, read by the backend and that sidecar (the two
# ends cannot drift): secrets/steam_sidecar_internal_key.txt,
# secrets/blockchain_sidecar_internal_key.txt, secrets/ethereum_sidecar_internal_key.txt.
# REQUIRED, >= 32 characters, each different (openssl rand -hex 32). The old
# INTERNAL_KEY / STEAM_SIDECAR_INTERNAL_KEY / BLOCKCHAIN_SIDECAR_INTERNAL_KEY
# variables are not passed to any container (secrets/README.md).

# --- Steam Market price source (DEPLOY_RUNBOOK §C.1) ---
# "logging"      → LoggingSteamMarketPriceClient returns NoPrice(); the
#                  PRICE_DEVIATION fraud rule stays silent (fail-open) and
#                  nothing reaches out to steamcommunity.com. Safe default.
# "steam-market" → real HTTP client. Required for PRICE_DEVIATION to fire, and
#                  only meaningful together with a tightened
#                  SKINORA_SETTING_PRICE_DEVIATION_THRESHOLD (seed is 1.0 = 100%).
STEAM_MARKET_PROVIDER=logging

# =============================================================================
# Mandatory SystemSettings (19) — see Docs/DEPLOY_RUNBOOK.md §A
# -----------------------------------------------------------------------------
# These 19 SystemSetting rows ship UNCONFIGURED (no seed default). The backend
# SettingsBootstrapService hydrates them from these env vars at startup and
# FAIL-FAST (InvalidOperationException, container exit) if any is missing or
# fails type/range validation. Already-configured rows (set via the admin UI)
# are NOT overridden by env (06 §8.9). Values below mirror the test fixture;
# set real production values deliberately by risk profile.
# =============================================================================
SKINORA_SETTING_ACCEPT_TIMEOUT_MINUTES=60
SKINORA_SETTING_SELLER_CONFIRM_TIMEOUT_MINUTES=60
SKINORA_SETTING_PAYMENT_TIMEOUT_MIN_MINUTES=15
SKINORA_SETTING_PAYMENT_TIMEOUT_MAX_MINUTES=60
SKINORA_SETTING_PAYMENT_TIMEOUT_DEFAULT_MINUTES=30
# T169: 720 = the owner's 12-hour delivery window (2026-10-04).
SKINORA_SETTING_DELIVERY_TIMEOUT_MINUTES=720
# Production: keep this above the payout gas cost, not 1.0 — a payout the hot
# wallet's Energy no longer covers burns ~2.2-4.4 USDT and a cheaper sale's
# payout is deferred (DEPLOY_RUNBOOK §A row 7, 02 §4.7).
# T169 (owner decision 2026-10-21): min 10 (an Ethereum sale's commission covers
# its fee); max 2900 (a Turkish exchange's 3000 $ daily stablecoin withdrawal,
# MASAK Tebliğ 29 m. 4/4, minus commission and the TRON fee line). TRON has its
# own minimum, 50 (blockchain.tron.min_transaction_amount_usdt, seeded).
SKINORA_SETTING_MIN_TRANSACTION_AMOUNT=10
SKINORA_SETTING_MAX_TRANSACTION_AMOUNT=2900
SKINORA_SETTING_MAX_CONCURRENT_TRANSACTIONS=5
SKINORA_SETTING_NEW_ACCOUNT_TRANSACTION_LIMIT=3
SKINORA_SETTING_NEW_ACCOUNT_PERIOD_DAYS=14
SKINORA_SETTING_CANCEL_LIMIT_COUNT=3
SKINORA_SETTING_CANCEL_LIMIT_PERIOD_HOURS=24
SKINORA_SETTING_CANCEL_COOLDOWN_HOURS=1
SKINORA_SETTING_HIGH_VOLUME_AMOUNT_THRESHOLD=5000.0
SKINORA_SETTING_HIGH_VOLUME_COUNT_THRESHOLD=10
SKINORA_SETTING_HIGH_VOLUME_PERIOD_HOURS=24
# T169 (öneriyle kaydedildi — ⚠): 4000 per network (single cap 3000 + ~25 days
# of commission); on the alert move to cold until ≤ 500 stays hot.
SKINORA_SETTING_HOT_WALLET_LIMIT=4000
SKINORA_SETTING_DORMANT_ACCOUNT_VALUE_THRESHOLD=1000.0

# The DEPLOY_RUNBOOK §C "recommended for production" settings (reconciliation
# wallet addresses, auth.banned_countries, multi_account.exchange_addresses,
# price_deviation_threshold) are deliberately NOT listed here: they ship as
# seeded Default rows (IsConfigured = true) and the bootstrap only hydrates
# unconfigured rows — env never overrides a configured value (06 §8.9).
# Change them through the admin UI.

# =============================================================================
# Sidecar cadence / sweep parity — see Docs/DEPLOY_RUNBOOK.md §D
# -----------------------------------------------------------------------------
# These live in BOTH the backend SystemSetting catalog (admin visibility) AND
# the blockchain sidecar env. The sidecar reads its OWN env at boot — changing
# the backend SystemSetting does NOT propagate to a running sidecar (T74 K1 /
# T96 deferred). To change a cadence: update the sidecar env below AND restart
# the sidecar; keep the backend SystemSetting in parity for admin visibility.
# =============================================================================
POST_CANCEL_CADENCE_24H_MS=30000
POST_CANCEL_CADENCE_7D_MS=300000
POST_CANCEL_CADENCE_30D_MS=3600000
SWEEP_TRX_FALLBACK_SUN=15000000

# --- Reverse proxy (F3a) -------------------------------------------------
# Backend istemci IP'sini yalnız BURADA yazan ağdan gelen X-Forwarded-For
# başlığına güvenerek çözer. Boş bırakılırsa forwarded header hiç işlenmez
# ve RemoteIpAddress proxy'nin IP'si olarak kalır (rate limit izolasyonu,
# geo-block ve VPN sinyali sessizce etkisiz olur).
# Üretimde SADECE reverse proxy'nin bulunduğu ağ/adres yazılmalıdır.
REVERSE_PROXY_KNOWN_NETWORK=172.20.0.0/16
# Zincirdeki proxy sayısı. Tek nginx için 1; önünde CDN varsa artırın.
REVERSE_PROXY_FORWARD_LIMIT=1
