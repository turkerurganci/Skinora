# =============================================================================
# Skinora — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# --- General ---
NODE_ENV=development
ASPNETCORE_ENVIRONMENT=Development

# --- Backend (.NET) ---
BACKEND_PORT=5000

# --- Public origin ---
# The single browser-facing origin. nginx (skinora-reverse-proxy) serves the
# frontend and proxies /api + /hubs + /health to the backend, so one origin is
# enough — this is what you open in the browser and what Steam OpenID and CORS
# are configured against. Must match NGINX_HTTP_PORT below.
PUBLIC_ORIGIN=http://localhost:8080

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# NOTE: NEXT_PUBLIC_* are inlined by Next.js at BUILD time and the frontend
# Dockerfile takes no build args — setting these at runtime in docker-compose
# has NO effect on the built image. The image is built with the same-origin
# defaults ("/api/v1" in lib/api/client.ts, "/hubs" in lib/signalr/connection.ts),
# which is exactly what the nginx single-origin setup needs. Only set these when
# you rebuild the frontend image for a split-origin deployment.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SIGNALR_URL=

# --- SQL Server ---
DB_PORT=1433
MSSQL_SA_PASSWORD=YourStrong!Password123
MSSQL_PID=Developer
DB_CONNECTION_STRING=Server=skinora-db,1433;Database=Skinora;User Id=sa;Password=YourStrong!Password123;TrustServerCertificate=True;

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=YourRedisPassword123
REDIS_CONNECTION_STRING=skinora-redis:6379,password=YourRedisPassword123

# --- Nginx ---
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# --- Steam authentication (OpenID 2.0 + Web API) — 08 §2.1, §2.2 ---
# Steam redirects the user's browser back to RETURN_TO after consent, so these
# must be reachable from the browser (localhost is fine). The appsettings.json
# defaults point at https://skinora.com — override them or real login breaks.
STEAM_OPENID_REALM=http://localhost:8080
STEAM_OPENID_RETURN_TO=http://localhost:8080/api/v1/auth/steam/callback
STEAM_OPENID_REVERIFY_RETURN_TO=http://localhost:8080/api/v1/auth/steam/re-verify/callback
STEAM_OPENID_FRONTEND_CALLBACK=http://localhost:8080/auth/callback

# --- Steam Sidecar ---
STEAM_SIDECAR_PORT=5100
STEAM_SIDECAR_BACKEND_URL=http://skinora-backend:5000
# Steam Web API key — https://steamcommunity.com/dev/apikey
# Used by the sidecar (inventory) and by the backend (OpenID profile name/avatar;
# when empty login still succeeds but the profile falls back to a placeholder).
STEAM_API_KEY=your_steam_api_key_here
# Escrow bot credentials. The sidecar resolves STEAM_BOTS_CONFIG_PATH first, then
# STEAM_BOTS_JSON; with neither it starts in skeleton mode and CANNOT send trade
# offers. The file is mounted read-only from ./secrets — see secrets/README.md.
STEAM_BOTS_CONFIG_PATH=/run/secrets/steam-bots.json
# Inventory cache (08 §2.3). Empty → in-memory fallback (dev/test only).
STEAM_SIDECAR_REDIS_URL=redis://:YourRedisPassword123@skinora-redis:6379

# --- Webhook (T68) ---
# HMAC-SHA256 shared secret between sidecar → backend webhooks (05 §3.4, 09 §11.3).
# Min 32 characters of cryptographic randomness: openssl rand -hex 32
WEBHOOK_SECRET=your_webhook_hmac_secret_minimum_32_characters_long
# Separate secret for the blockchain sidecar's webhooks. Falls back to
# WEBHOOK_SECRET when unset; set it separately to blast-radius the two surfaces.
BLOCKCHAIN_WEBHOOK_SECRET=

# --- Blockchain Sidecar ---
BLOCKCHAIN_SIDECAR_PORT=5200
BLOCKCHAIN_SIDECAR_BACKEND_URL=http://skinora-backend:5000
TRON_NETWORK=nile
TRON_FULL_NODE_URL=https://nile.trongrid.io
# TronGrid API key — https://www.trongrid.io (free tier). Without it TronGrid
# rate-limits (429) the payment monitor. SECONDARY enables key failover (WP10).
TRON_API_KEY=your_trongrid_api_key_here
TRON_API_KEY_SECONDARY=
# TRC-20 token contracts (08 §3.3). MAINNET addresses are hardcoded in the
# sidecar; on nile/shasta they MUST be supplied here or the supported-token
# allowlist is empty and every incoming transfer is classified wrong/spam token.
TRON_USDT_CONTRACT=
TRON_USDC_CONTRACT=
# HD wallet master mnemonic — derives per-transaction deposit addresses
# (08 §3.2, m/44'/195'/0'/0/{index}). NEVER commit. Use a testnet-only mnemonic.
HD_WALLET_MNEMONIC=your_hd_wallet_mnemonic_here
# Hot wallet — operationally distinct from the HD master (05 §3.3, §3.5).
# Signs SELLER_PAYOUT / refund / sweep and delegates Energy to deposit
# addresses. Passed ONLY to the blockchain sidecar; the backend never sees it.
HOT_WALLET_ADDRESS=
HOT_WALLET_PRIVATE_KEY=

# --- Observability (T08) ---
LOKI_PORT=3100
LOKI_URL=http://skinora-loki:3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Monitoring (T16) ---
PROMETHEUS_PORT=9090
UPTIME_KUMA_PORT=3002

# --- Alerting (T16) ---
# REQUIRED FOR GRAFANA TO START — not merely for alerts to be delivered.
# infra/grafana/provisioning/alerting/contactpoints.yml declares a Telegram
# contact point, and Grafana provisioning has no conditionals: a declared
# contact point must validate or Grafana aborts startup and the container
# crash-loops. Leave these empty and you get
#   "failed to validate integration telegram-critical: could not find Bot Token"
# Values are substituted into the provisioning tree by the
# skinora-grafana-provisioning render step (see docker-compose.yml) before
# Grafana parses it — Grafana's own ${VAR} interpolation cannot be used here
# because it re-types the value and a numeric chat id then fails the
# integration's string field.
# For a local rehearsal without a real bot, any non-empty values work.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ALERT_EMAIL_TO=admin@skinora.com

# --- JWT ---
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_ISSUER=skinora
JWT_AUDIENCE=skinora-client
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- Internal API key (backend ↔ sidecar) ---
# Shared X-Internal-Key for backend → sidecar internal API auth (05 §3.4).
# Both sides of a pair must match: the backend sends it, the sidecar checks it.
INTERNAL_KEY=your_internal_api_key_here
# Per-sidecar overrides. Leave empty to use INTERNAL_KEY for both; set them
# separately so a leaked Steam-side key does not also unlock the wallet surface.
STEAM_SIDECAR_INTERNAL_KEY=
BLOCKCHAIN_SIDECAR_INTERNAL_KEY=

# --- Steam Market price source (DEPLOY_RUNBOOK §C.1) ---
# "logging"      → LoggingSteamMarketPriceClient returns NoPrice(); the
#                  PRICE_DEVIATION fraud rule stays silent (fail-open) and
#                  nothing reaches out to steamcommunity.com. Safe default.
# "steam-market" → real HTTP client. Required for PRICE_DEVIATION to fire, and
#                  only meaningful together with a tightened
#                  SKINORA_SETTING_PRICE_DEVIATION_THRESHOLD (seed is 1.0 = 100%).
STEAM_MARKET_PROVIDER=logging

# =============================================================================
# Mandatory SystemSettings (19) — see Docs/DEPLOY_RUNBOOK.md §A
# -----------------------------------------------------------------------------
# These 19 SystemSetting rows ship UNCONFIGURED (no seed default). The backend
# SettingsBootstrapService hydrates them from these env vars at startup and
# FAIL-FAST (InvalidOperationException, container exit) if any is missing or
# fails type/range validation. Already-configured rows (set via the admin UI)
# are NOT overridden by env (06 §8.9). Values below mirror the test fixture;
# set real production values deliberately by risk profile.
# =============================================================================
SKINORA_SETTING_ACCEPT_TIMEOUT_MINUTES=60
SKINORA_SETTING_TRADE_OFFER_SELLER_TIMEOUT_MINUTES=60
SKINORA_SETTING_PAYMENT_TIMEOUT_MIN_MINUTES=15
SKINORA_SETTING_PAYMENT_TIMEOUT_MAX_MINUTES=60
SKINORA_SETTING_PAYMENT_TIMEOUT_DEFAULT_MINUTES=30
SKINORA_SETTING_TRADE_OFFER_BUYER_TIMEOUT_MINUTES=60
SKINORA_SETTING_MIN_TRANSACTION_AMOUNT=1.0
SKINORA_SETTING_MAX_TRANSACTION_AMOUNT=10000.0
SKINORA_SETTING_MAX_CONCURRENT_TRANSACTIONS=5
SKINORA_SETTING_NEW_ACCOUNT_TRANSACTION_LIMIT=3
SKINORA_SETTING_NEW_ACCOUNT_PERIOD_DAYS=14
SKINORA_SETTING_CANCEL_LIMIT_COUNT=3
SKINORA_SETTING_CANCEL_LIMIT_PERIOD_HOURS=24
SKINORA_SETTING_CANCEL_COOLDOWN_HOURS=1
SKINORA_SETTING_HIGH_VOLUME_AMOUNT_THRESHOLD=5000.0
SKINORA_SETTING_HIGH_VOLUME_COUNT_THRESHOLD=10
SKINORA_SETTING_HIGH_VOLUME_PERIOD_HOURS=24
SKINORA_SETTING_HOT_WALLET_LIMIT=100000.0
SKINORA_SETTING_DORMANT_ACCOUNT_VALUE_THRESHOLD=1000.0

# The DEPLOY_RUNBOOK §C "recommended for production" settings (reconciliation
# wallet addresses, auth.banned_countries, multi_account.exchange_addresses,
# price_deviation_threshold) are deliberately NOT listed here: they ship as
# seeded Default rows (IsConfigured = true) and the bootstrap only hydrates
# unconfigured rows — env never overrides a configured value (06 §8.9).
# Change them through the admin UI.

# =============================================================================
# Sidecar cadence / sweep parity — see Docs/DEPLOY_RUNBOOK.md §D
# -----------------------------------------------------------------------------
# These live in BOTH the backend SystemSetting catalog (admin visibility) AND
# the blockchain sidecar env. The sidecar reads its OWN env at boot — changing
# the backend SystemSetting does NOT propagate to a running sidecar (T74 K1 /
# T96 deferred). To change a cadence: update the sidecar env below AND restart
# the sidecar; keep the backend SystemSetting in parity for admin visibility.
# =============================================================================
POST_CANCEL_CADENCE_24H_MS=30000
POST_CANCEL_CADENCE_7D_MS=300000
POST_CANCEL_CADENCE_30D_MS=3600000
SWEEP_ENERGY_DELEGATION_SUN=200000000
SWEEP_TRX_FALLBACK_SUN=15000000
