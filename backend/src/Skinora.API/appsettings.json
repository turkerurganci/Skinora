{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://skinora-loki:3100",
          "labels": [
            { "key": "service", "value": "skinora-backend" },
            { "key": "environment", "value": "production" }
          ],
          "propertiesAsLabels": ["level"],
          "textFormatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext"],
    "Properties": {
      "service": "skinora-backend"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=Skinora;User Id=sa;Password=REPLACE_IN_ENV;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:3000"]
  },
  "Jwt": {
    "Secret": "REPLACE_IN_ENV_minimum_32_characters",
    "Issuer": "skinora",
    "Audience": "skinora-client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "PreviousSecret": ""
  },
  "SteamOpenId": {
    "Realm": "https://skinora.com",
    "ReturnToUrl": "https://skinora.com/api/v1/auth/steam/callback",
    "ReVerifyReturnToUrl": "https://skinora.com/api/v1/auth/steam/re-verify/callback",
    "FrontendCallbackUrl": "https://skinora.com/auth/callback",
    "DefaultReturnPath": "/dashboard",
    "WebApiKey": ""
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=REPLACE_IN_ENV,abortConnect=false"
  },
  "SteamSidecar": {
    "BaseUrl": "http://skinora-steam-sidecar:5100",
    "InternalKey": "REPLACE_IN_ENV",
    "TimeoutSeconds": 30
  },
  "BlockchainSidecar": {
    "BaseUrl": "http://skinora-blockchain-sidecar:5200",
    "InternalKey": "REPLACE_IN_ENV",
    "TimeoutSeconds": 10
  },
  "HealthProbe": {
    "Enabled": true,
    "ProbeCron": "* * * * *",
    "FailureThreshold": 3
  },
  "Webhook": {
    "BlockchainSharedSecret": "REPLACE_IN_ENV",
    "ReplayWindowSeconds": 300,
    "NonceRetentionSeconds": 3600
  },
  "Resend": {
    "Provider": "logging",
    "ApiKey": "REPLACE_IN_ENV",
    "BaseUrl": "https://api.resend.com",
    "FromAddress": "Skinora <noreply@skinora.com>",
    "TimeoutSeconds": 10,
    "WebhookSigningSecret": "REPLACE_IN_ENV",
    "WebhookReplayWindowSeconds": 300
  },
  "Telegram": {
    "Provider": "logging",
    "BotToken": "REPLACE_IN_ENV",
    "BotUsername": "SkinoraBot",
    "BotUrl": "https://t.me/SkinoraBot",
    "BaseUrl": "https://api.telegram.org",
    "TimeoutSeconds": 10,
    "WebhookSecretToken": "REPLACE_IN_ENV",
    "CodeTtlSeconds": 600,
    "MaxFailedAttempts": 5,
    "IdempotencyTtlHours": 24,
    "PerChatRatePerSecond": 1,
    "GlobalRatePerSecond": 30
  },
  "Discord": {
    "Provider": "logging",
    "ClientId": "REPLACE_IN_ENV",
    "ClientSecret": "REPLACE_IN_ENV",
    "BotToken": "REPLACE_IN_ENV",
    "AuthorizeUrl": "https://discord.com/api/oauth2/authorize",
    "BaseUrl": "https://discord.com/api/v10",
    "RedirectUri": "https://skinora.com/api/v1/users/me/settings/discord/callback",
    "Scope": "identify",
    "StateTtlSeconds": 600,
    "SuccessRedirectUrl": "/settings?discord=connected",
    "FailureRedirectUrl": "/settings?discord=error",
    "TimeoutSeconds": 10,
    "GlobalRatePerSecond": 45,
    "DmChannelCacheTtlHours": 24,
    "MaxRetries": 3
  },
  "SteamMarket": {
    "Provider": "logging",
    "BaseUrl": "https://steamcommunity.com",
    "AppId": 730,
    "Currency": 1,
    "TimeoutSeconds": 10,
    "RateLimitPerMinute": 20,
    "FreshTtlHours": 24,
    "StaleTtlHours": 48
  },
  "Geolocation": {
    "DatabasePath": ""
  },
  "VpnDetection": {
    "Enabled": false,
    "TorExitListUrl": "https://check.torproject.org/torbulkexitlist",
    "CacheDurationMinutes": 60,
    "RefreshTimeoutSeconds": 10
  },
  "RateLimit": {
    "Enabled": true,
    "KeyPrefix": "skinora:ratelimit",
    "Policies": {
      "auth":            { "Limit": 10,  "WindowSeconds": 60 },
      "session":         { "Limit": 30,  "WindowSeconds": 60 },
      "user-read":       { "Limit": 60,  "WindowSeconds": 60 },
      "user-write":      { "Limit": 20,  "WindowSeconds": 60 },
      "steam-inventory": { "Limit": 5,   "WindowSeconds": 60 },
      "admin-read":      { "Limit": 120, "WindowSeconds": 60 },
      "admin-write":     { "Limit": 30,  "WindowSeconds": 60 },
      "public":          { "Limit": 30,  "WindowSeconds": 60 }
    }
  },
  "Hangfire": {
    "DashboardEnabled": true,
    "DashboardPath": "/hangfire",
    "SchemaName": "HangFire",
    "PollingIntervalSeconds": 15,
    "DefaultRetryAttempts": 3,
    "WorkerCount": null
  },
  "Outbox": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxRetryCount": 5,
    "LockAcquireTimeoutSeconds": 0,
    "DefaultExternalIdempotencyLeaseSeconds": 300
  },
  "Platform": {
    "UptimePercent": 99.9
  }
}
