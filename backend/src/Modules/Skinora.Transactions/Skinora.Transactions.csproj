<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Skinora.Shared\Skinora.Shared.csproj" />
    <ProjectReference Include="..\Skinora.Users\Skinora.Users.csproj" />
    <ProjectReference Include="..\Skinora.Platform\Skinora.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hangfire.Core supplies the [DisableConcurrentExecution] server filter
         that serialises the SellerPayoutQueueJob producer (money-safety, WP1
         F1). Mirrors Skinora.Notifications, which already references
         Hangfire.Core for its [AutomaticRetry] job filter. -->
    <PackageReference Include="Hangfire.Core" Version="1.8.18" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Stateless" Version="5.20.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
