  <data name="TRANSACTION_INVITE_Title" xml:space="preserve">
    <value>Yeni işlem davetin var</value>
  </data>
  <data name="TRANSACTION_INVITE_Body" xml:space="preserve">
    <value>{ItemName} için işlem daveti aldın ({Amount} USDT).</value>
  </data>
  <data name="BUYER_ACCEPTED_Title" xml:space="preserve">
    <value>Alıcı işlemi kabul etti</value>
  </data>
  <data name="BUYER_ACCEPTED_Body" xml:space="preserve">
    <value>{BuyerName} işlemini kabul etti.</value>
  </data>
  <data name="PAYMENT_WINDOW_OPEN_Title" xml:space="preserve">
    <value>Satıcı hazır — ödeme bekleniyor</value>
  </data>
  <data name="PAYMENT_WINDOW_OPEN_Body" xml:space="preserve">
    <value>İşlemi tamamlamak için {PaymentAddress} adresine {Amount} USDT gönder.</value>
  </data>
  <data name="PAYMENT_RECEIVED_Title" xml:space="preserve">
    <value>Ödeme alındı</value>
  </data>
  <data name="PAYMENT_RECEIVED_Body" xml:space="preserve">
    <value>İşlemin için {Amount} USDT alındı.</value>
  </data>
  <data name="DELIVERY_EXPECTED_Title" xml:space="preserve">
    <value>Ödeme emanete alındı — item'ı gönder</value>
  </data>
  <data name="DELIVERY_EXPECTED_Body" xml:space="preserve">
    <value>Alıcı ödemeyi yaptı. Teslimat süresi dolmadan item'ı Steam üzerinden alıcıya gönder.</value>
  </data>
  <data name="TRANSACTION_COMPLETED_Title" xml:space="preserve">
    <value>İşlem tamamlandı</value>
  </data>
  <data name="TRANSACTION_COMPLETED_Body" xml:space="preserve">
