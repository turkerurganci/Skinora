  </data>
  <data name="SELLER_PAYMENT_SENT_Title" xml:space="preserve">
    <value>Ödeme gönderildi</value>
  </data>
  <data name="SELLER_PAYMENT_SENT_Body" xml:space="preserve">
    <value>Cüzdanına {Amount} USDT gönderildi.</value>
  </data>
  <data name="TIMEOUT_WARNING_Title" xml:space="preserve">
    <value>Süre dolmak üzere</value>
  </data>
  <data name="TIMEOUT_WARNING_Body" xml:space="preserve">
    <value>İşlem süresi {RemainingMinutes} dakika sonra dolacak.</value>
  </data>
  <data name="TRANSACTION_CANCELLED_Title" xml:space="preserve">
    <value>İşlem iptal edildi</value>
  </data>
  <data name="TRANSACTION_CANCELLED_Body" xml:space="preserve">
    <value>{ItemName} işlemi iptal edildi: {Reason}.</value>
  </data>
  <data name="TRANSACTION_FLAGGED_Title" xml:space="preserve">
    <value>İşlem işaretlendi</value>
  </data>
  <data name="TRANSACTION_FLAGGED_Body" xml:space="preserve">
    <value>{TransactionId} numaralı işlem inceleme altında.</value>
  </data>
  <data name="PAYMENT_INCORRECT_Title" xml:space="preserve">
    <value>Hatalı ödeme tutarı</value>
  </data>
  <data name="PAYMENT_INCORRECT_Body" xml:space="preserve">
    <value>{ReceivedAmount} USDT aldık ama beklenen tutar {ExpectedAmount} USDT idi.</value>
  </data>
  <data name="LATE_PAYMENT_REFUNDED_Title" xml:space="preserve">
    <value>Geç ödeme iade edildi</value>
  </data>
  <data name="LATE_PAYMENT_REFUNDED_Body" xml:space="preserve">
    <value>Cüzdanına {Amount} USDT iade edildi.</value>
  </data>
  <data name="PAYMENT_REFUNDED_Title" xml:space="preserve">
    <value>Ödeme iade edildi</value>
  </data>
  <data name="PAYMENT_REFUNDED_Body" xml:space="preserve">
    <value>{TransactionId} numaralı işlem için ödemeniz {RefundAddress} adresine iade ediliyor. Ağ ücreti tutardan düşülür.</value>
  </data>
  <data name="DISPUTE_RESULT_Title" xml:space="preserve">
    <value>Anlaşmazlık çözüldü</value>
  </data>
  <data name="DISPUTE_RESULT_Body" xml:space="preserve">
    <value>Anlaşmazlık çözüldü: {Outcome}.</value>
  </data>
  <data name="FLAG_RESOLVED_Title" xml:space="preserve">
    <value>İşaret kaldırıldı</value>
  </data>
  <data name="FLAG_RESOLVED_Body" xml:space="preserve">
    <value>{TransactionId} numaralı işlemin incelemesi sonuçlandı ({Outcome}). Güncel durumu için işlemi açın.</value>
  </data>
  <data name="ADMIN_FLAG_ALERT_Title" xml:space="preserve">
    <value>Admin: işaret uyarısı</value>
  </data>
  <data name="ADMIN_FLAG_ALERT_Body" xml:space="preserve">
    <value>{TransactionId} numaralı işlem işaretlendi: {Reason}.</value>
  </data>
  <data name="ADMIN_ESCALATION_Title" xml:space="preserve">
    <value>Admin: yükseltme</value>
  </data>
  <data name="ADMIN_ESCALATION_Body" xml:space="preserve">
    <value>{TransactionId} numaralı işlem üst mercie iletildi.</value>
  </data>
  <data name="ADMIN_PAYMENT_FAILURE_Title" xml:space="preserve">
    <value>Admin: ödeme hatası</value>
  </data>
  <data name="ADMIN_PAYMENT_FAILURE_Body" xml:space="preserve">
    <value>{TransactionId} numaralı işlemin ödemesi başarısız oldu ({ErrorCode}).</value>
  </data>
  <data name="EMERGENCY_HOLD_APPLIED_Title" xml:space="preserve">
    <value>İşleminiz inceleme için geçici olarak donduruldu</value>
  </data>
  <data name="EMERGENCY_HOLD_APPLIED_Body" xml:space="preserve">
    <value>{ItemName} işlemi platform tarafından inceleme nedeniyle geçici olarak donduruldu: {Reason}.</value>
  </data>
  <data name="EMERGENCY_HOLD_RELEASED_Title" xml:space="preserve">
    <value>İnceleme tamamlandı — işlem devam ediyor</value>
  </data>
  <data name="EMERGENCY_HOLD_RELEASED_Body" xml:space="preserve">
    <value>{ItemName} işlemi {ResumedStatus} aşamasından devam ediyor. Sayaç kaldığı yerden işliyor.</value>
  </data>
  <data name="ADMIN_PLATFORM_OUTAGE_Title" xml:space="preserve">
    <value>Admin: platform sağlık uyarısı</value>
  </data>
  <data name="ADMIN_PLATFORM_OUTAGE_Body" xml:space="preserve">
    <value>{Component} sidecar sağlık durumu: {Status}.</value>
  </data>
  <data name="INSUFFICIENT_PAYMENT_Title" xml:space="preserve">
    <value>Eksik ödeme — doğru tutarı tekrar gönder</value>
  </data>
  <data name="INSUFFICIENT_PAYMENT_Body" xml:space="preserve">
    <value>{ReceivedAmount} {Stablecoin} aldık ama beklenen {ExpectedAmount} {Stablecoin} idi. Alınan tutar {SourceAddress} adresine iade ediliyor; lütfen süre dolmadan önce {ExpectedAmount} {Stablecoin} tutarının tamamını tekrar gönder.</value>
  </data>
  <data name="OVERPAYMENT_REFUNDED_Title" xml:space="preserve">
    <value>Fazla ödeme iade ediliyor</value>
  </data>
  <data name="OVERPAYMENT_REFUNDED_Body" xml:space="preserve">
    <value>{ReceivedAmount} {Stablecoin} gönderdin ama yalnızca {ExpectedAmount} {Stablecoin} gerekliydi. Aradaki {ExcessAmount} {Stablecoin} farkı {SourceAddress} adresine iade ediliyor.</value>
  </data>
  <data name="WRONG_TOKEN_REFUND_Title" xml:space="preserve">
    <value>Yanlış token tespit edildi — iade ediliyor</value>
  </data>
  <data name="WRONG_TOKEN_REFUND_Body" xml:space="preserve">
    <value>İşlem {ExpectedStablecoin} bekliyordu ama {ReceivedAmount} {ActualStablecoin} alındı. Tutar {SourceAddress} adresine iade ediliyor; lütfen doğru token ile tekrar gönder.</value>
  </data>
  <data name="ACCOUNT_SUSPENDED_Title" xml:space="preserve">
    <value>Hesabınız askıya alındı</value>
  </data>
  <data name="ACCOUNT_SUSPENDED_Body" xml:space="preserve">
    <value>Skinora hesabınız askıya alındı: {Reason}. Aktif işlemlerinizi görüntülemeye devam edebilirsiniz ancak askı kaldırılana kadar işlem başlatamaz veya kabul edemezsiniz.</value>
  </data>
  <data name="ACCOUNT_UNSUSPENDED_Title" xml:space="preserve">
    <value>Hesap askınız kaldırıldı</value>
  </data>
  <data name="ACCOUNT_UNSUSPENDED_Body" xml:space="preserve">
    <value>Skinora hesabınız yeniden aktif. Artık normal şekilde işlem başlatıp kabul edebilirsiniz.</value>
  </data>
  <data name="PAYOUT_ISSUE_RESOLVED_Title" xml:space="preserve">
    <value>Ödeme sorunun çözüldü</value>
  </data>
  <data name="PAYOUT_ISSUE_RESOLVED_Body" xml:space="preserve">
    <value>Bildirdiğin ödeme sorunu çözüldü. Ayrıntıları işlem sayfasından görebilirsin.</value>
  </data>
